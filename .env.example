NODE_ENV=development
PORT=4000
# For Staging/Production MongoDB Atlas:
# MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/sellzy_staging?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/sellzy_dev
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2
REDIS_URI=redis://localhost:6379
JWT_SECRET=super-secret-jwt-key-sellzy-dev-only-change-in-prod
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
